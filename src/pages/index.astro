  else if(repTab==='التحصيل')html=repTable(invs.filter(i=>i.cashPaid>0).map(i=>[i.date,i.id,i.subName,fmt(i.cashPaid),'نقدي']),['التاريخ','الفاتورة','المشترك','المبلغ (ريال)','الطريقة'])+`<p class="mt-2 font-black">إجمالي التحصيل النقدي الفعلي: ${fmt(invs.reduce((a,i)=>a+i.cashPaid,0))} ريال (بدون احتساب الأرصدة المرحلة)</p>`;
  else if(repTab==='الديون')html=repTable(invs.filter(i=>i.remainingOn>0).map(i=>[i.subName,i.meterNo,i.id,fmt(i.remainingOn)]),['المشترك','العداد','الفاتورة','الباقي عليه (ريال)']);
  else if(repTab==='الأرصدة')html=repTable(invs.filter(i=>i.remainingFor>0).map(i=>[i.subName,i.meterNo,i.id,fmt(i.remainingFor)]),['المشترك','العداد','الفاتورة','الباقي له (ريال)']);
  else if(repTab==='المصروفات'){const ex=DB.expenses.filter(e=>!cy||e.cycleId===cy);html=repTable(ex.map(e=>[e.date,e.category,e.desc,fmt(e.amount),e.paidTo||'']),['التاريخ','التصنيف','الوصف','المبلغ (ريال)','المدفوع له'])}
  else html=repTable(invs.map(i=>[i.subName,i.meterNo,fmt(i.prev),fmt(i.curr),fmt(i.cons)+' كيلو',i.status]),['المشترك','العداد','السابقة','الحالية','الاستهلاك','الحالة']);
  $('report-body').innerHTML=html;
}
function repTable(rows,heads){if(!rows.length)return emptyState('لا بيانات لهذا التقرير');return`<table class="rep"><thead><tr>${heads.map(h=>`<th>${h}</th>`).join('')}</tr></thead><tbody>${rows.map(r=>`<tr>${r.map(c=>`<td>${c}</td>`).join('')}</tr>`).join('')}</tbody></table>`}

