/* ===== منطق الحساب ===== */
function meterStatus(prev,curr){
  prev=+prev||0;curr=+curr||0;const diff=curr-prev;
  if(prev===0&&curr===0)return'بدون عداد';
  if(diff>0)return'شغال';
  if(diff<0)return'خارب - عد عكسي';
  return'خارب - متوقف';
}
function consumptionOf(prev,curr){const d=(+curr||0)-(+prev||0);return d>0?d:0}
function lastInvoice(meterNo,excludeId){const ordered=DB.invoices.filter(i=>i.meterNo===meterNo).sort((a,b)=>a.date.localeCompare(b.date)||a.id.localeCompare(b.id));const at=excludeId?ordered.findIndex(i=>i.id===excludeId):-1;const prior=at>=0?ordered.slice(0,at):ordered;return prior.length?enrich(prior[prior.length-1]):null}
function calcInvoice({meterNo,type,prev,curr,fine=0,cashPaid=0,arrears=null,prevBalance=null,excludeId=null}){
  const status=meterStatus(prev,curr),cons=consumptionOf(prev,curr);
  const t=DB.settings.tariffs[type]||{price:200,fixed:2000};
  let consValue=0;
  if(status==='شغال')consValue=cons*t.price;
  else if(status==='خارب - متوقف'||status==='بدون عداد')consValue=t.fixed;
  else consValue=0;
  const last=lastInvoice(meterNo,excludeId);
  if(arrears==null)arrears=last?last.remainingOn:0;
  if(prevBalance==null)prevBalance=last?last.remainingFor:0;
  const totalDue=consValue+(+arrears||0)+(+fine||0);
  const totalReceived=(+cashPaid||0)+(+prevBalance||0);
  let remainingOn=0,remainingFor=0;
  if(totalDue>totalReceived)remainingOn=totalDue-totalReceived;
  else if(totalReceived>totalDue)remainingFor=totalReceived-totalDue;
  return{status,cons,consValue,arrears:+arrears||0,prevBalance:+prevBalance||0,fine:+fine||0,cashPaid:+cashPaid||0,totalDue,totalReceived,remainingOn,remainingFor};
}
function enrich(inv){
  const s=DB.subscribers.find(x=>x.meterNo===inv.meterNo);
  const c=calcInvoice({meterNo:inv.meterNo,type:s?.type||'منزلي',prev:inv.prev,curr:inv.curr,fine:inv.fine,cashPaid:inv.cashPaid,arrears:inv.arrears,prevBalance:inv.prevBalance,excludeId:inv.id});
  return{...inv,subName:s?.name||'—',subType:s?.type||'—',phone:s?.phone||'',...c};
}
function openCycle(){return DB.cycles.find(c=>c.status==='مفتوحة')}
function cycleOf(id){return DB.cycles.find(c=>c.id===id)}

