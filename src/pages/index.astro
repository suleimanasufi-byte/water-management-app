---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import { AuthGate } from "../components/auth/KleapAuth";
---
<Base
  title="نظام إدارة مشروع المياه | الفواتير والحسابات"
  description="نظام عربي متكامل لإدارة مشاريع مياه الشرب في اليمن: المشتركون والفواتير والعدادات والدورات والمصروفات والتقارير والنسخ الاحتياطي."
  schema={[
    {"@type": "SoftwareApplication", "name": "نظام إدارة مشروع المياه", "applicationCategory": "BusinessApplication", "operatingSystem": "Web", "offers": {"@type": "Offer", "price": "0", "priceCurrency": "YER"}}
  ]}
>
<div dir="rtl" id="app-root" class="min-h-screen bg-background text-foreground">
  <Header />
  <style>.navlink{padding:.5rem .9rem;border-radius:.9rem;border:1px solid var(--border,#e5e7eb);background:var(--card,#fff);white-space:nowrap}.navlink:hover{background:#0284c7;color:#fff}.nav-add{background:linear-gradient(135deg,#0284c7,#0d9488)!important;color:#fff!important;border-color:transparent!important;box-shadow:0 2px 8px rgba(2,132,199,.35)}.nav-sep{width:1px;align-self:stretch;background:var(--border,#e5e7eb);flex:none;min-height:1.5rem}:global(.btn){padding:.6rem 1rem;border-radius:.9rem;border:1px solid var(--border,#e5e7eb);font-weight:800;background:var(--muted,#f1f5f9)}:global(.card){border:1px solid var(--border,#e5e7eb);border-radius:1rem;padding:1rem;background:var(--card,#fff)}.fld{display:block;font-weight:700;font-size:.85rem}.fld input,.fld select{width:100%;margin-top:.3rem;padding:.6rem .8rem;border-radius:.8rem;border:1px solid var(--border,#e5e7eb);background:var(--background,#fff)}:global(.inv-paper){background:#fff;color:#111;border-radius:1rem;padding:1.2rem}@media print{#print-area{display:block!important}body *{visibility:hidden}#print-area,#print-area *{visibility:visible}#print-area{position:absolute;inset:0}}</style>
  <script is:inline>function scrollToId(id){var el=document.getElementById(id);if(el)el.scrollIntoView({behavior:'smooth',block:'start'})}</script>

  <main class="max-w-7xl mx-auto px-4 pb-28 pt-6 space-y-8">
    <!-- ===== إدخال سريع ===== -->
    <div class="quick-actions grid grid-cols-3 gap-2 bg-background/95 backdrop-blur py-2">
      <a href="/new-subscriber" class="rounded-2xl p-4 text-center text-white font-black shadow active:scale-95 transition" style="background:linear-gradient(135deg,#0284c7,#0d9488)" aria-label="إضافة مشترك جديد">＋<br/>مشترك جديد<br/><span class="text-[11px] font-bold opacity-80">عداد + بيانات</span></a>
      <a href="/new-invoice" class="rounded-2xl p-4 text-center text-white font-black shadow active:scale-95 transition" style="background:linear-gradient(135deg,#0d9488,#0284c7)" aria-label="إصدار فاتورة جديدة">＋<br/>فاتورة جديدة<br/><span class="text-[11px] font-bold opacity-80">قراءة + حساب</span></a>
      <a href="/new-expense" class="rounded-2xl p-4 text-center bg-rose-600 text-white font-black shadow active:scale-95 transition" aria-label="تسجيل مصروف جديد">＋<br/>مصروف جديد<br/><span class="text-[11px] font-bold opacity-80">صيانة + رواتب</span></a>
    </div>


    <!-- ===== البطل ===== -->
    <section class="rounded-3xl p-6 md:p-10 border border-border relative" style="background:linear-gradient(135deg,#073a5c 0%,#0a6b60 100%)">
      <div class="relative z-10">
        <h1 class="text-3xl md:text-5xl font-black leading-tight" style="color:#ffffff;text-shadow:0 2px 12px rgba(0,0,0,.35)">نظام إدارة مشروع المياه</h1>
        <p class="mt-3 font-medium max-w-2xl" style="color:#eaf6f3">إدارة المشتركين وقراءات العدادات بالكيلو والفواتير والتحصيل النقدي والمصروفات والدورات المحاسبية — سريع، عربي بالكامل، ويحفظ بياناتك على جهازك.</p>

        <p class="mt-4 text-xs font-bold" style="color:#eaf6f3">وحدة الاستهلاك في النظام كله هي <b>كيلو</b> • العملة <b>ريال</b></p>
      </div>
    </section>

    <!-- ===== لوحة التحكم ===== -->
    <section id="dashboard">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-2xl font-black">لوحة التحكم</h2>
        <select id="dash-cycle" onchange="renderAll()" class="px-3 py-2 rounded-xl border border-border bg-card text-sm font-bold"></select>
      </div>
      <div id="dash-cards" class="grid grid-cols-2 lg:grid-cols-4 gap-3"></div>
      <div class="grid md:grid-cols-2 gap-3 mt-3">
        <div class="rounded-3xl border border-border bg-card p-5">
          <h3 class="font-black mb-3">التحصيل مقابل المصروفات (ريال)</h3>
          <div id="bar-chart" class="space-y-2"></div>
        </div>
        <div class="rounded-3xl border border-border bg-card p-5">
          <h3 class="font-black mb-3">الفواتير حسب حالة العداد</h3>
          <div id="meter-chart" class="flex flex-wrap gap-2"></div>
          <h3 class="font-black mt-5 mb-2">أحدث الفواتير</h3>
          <div id="dash-latest" class="space-y-2 text-sm"></div>
        </div>
      </div>
    </section>

    <!-- ===== المشتركون ===== -->
    <section id="subscribers" class="rounded-3xl border border-border bg-card p-5 md:p-7">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
        <h2 class="text-2xl font-black">المشتركون <span id="sub-count" class="text-sm font-bold text-muted-foreground"></span></h2>
        <button onclick="openSubModal()" class="px-4 py-2.5 rounded-2xl text-white font-black" style="background:linear-gradient(135deg,#0284c7,#0d9488)">＋ مشترك جديد</button>
      </div>
      <div class="grid md:grid-cols-4 gap-2 mb-4">
        <input id="sub-search" oninput="renderSubs()" placeholder="بحث بالاسم أو رقم العداد أو الهاتف…" class="md:col-span-2 px-4 py-2.5 rounded-2xl border border-border bg-background font-medium" />
        <select id="sub-filter-type" onchange="renderSubs()" class="px-3 py-2.5 rounded-2xl border border-border bg-background font-bold">
          <option value="">كل الأنواع</option><option>منزلي</option><option>تجاري</option><option>منزلي تجاري</option>
        </select>
        <select id="sub-filter-active" onchange="renderSubs()" class="px-3 py-2.5 rounded-2xl border border-border bg-background font-bold">
          <option value="">نشط + موقوف</option><option value="1">نشط فقط</option><option value="0">موقوف فقط</option>
        </select>
      </div>
      <div id="sub-list" class="grid md:grid-cols-2 gap-3"></div>
    </section>

    <!-- ===== الفواتير ===== -->
    <section id="invoices" class="rounded-3xl border border-border bg-card p-5 md:p-7">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
        <h2 class="text-2xl font-black">الفواتير</h2>
        <button onclick="openInvModal()" class="px-4 py-2.5 rounded-2xl text-white font-black" style="background:linear-gradient(135deg,#0284c7,#0d9488)">＋ فاتورة جديدة</button>
      </div>
      <div class="rounded-2xl border border-amber-500/40 bg-amber-500/10 p-3 text-sm font-bold mb-4">الترحيل تلقائي: القراءة السابقة والمتأخرات والرصيد تُجلب من آخر فاتورة للمشترك. إدخال القراءة أو المبلغ يعيد الحساب فورًا.</div>
      <div class="grid md:grid-cols-4 gap-2 mb-4">
        <input id="inv-search" oninput="renderInvs()" placeholder="بحث برقم الفاتورة أو اسم المشترك…" class="md:col-span-2 px-4 py-2.5 rounded-2xl border border-border bg-background" />
        <select id="inv-filter-cycle" onchange="renderInvs()" class="px-3 py-2.5 rounded-2xl border border-border bg-background font-bold"></select>
        <select id="inv-filter-status" onchange="renderInvs()" class="px-3 py-2.5 rounded-2xl border border-border bg-background font-bold">
          <option value="">كل الحالات</option><option>شغال</option><option>خارب - متوقف</option><option>بدون عداد</option><option>خارب - عد عكسي</option>
        </select>
      </div>
      <div id="inv-list" class="space-y-3"></div>
    </section>

    <!-- ===== المصروفات ===== -->
    <section id="expenses" class="rounded-3xl border border-border bg-card p-5 md:p-7">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <h2 class="text-2xl font-black">المصروفات</h2>
        <button onclick="openExpModal()" class="px-4 py-2.5 rounded-2xl bg-rose-600 text-white font-black">＋ مصروف جديد</button>
      </div>
      <div id="exp-cats" class="flex flex-wrap gap-2 mb-4"><span class="px-3 py-1.5 rounded-full border border-border text-xs font-black">صيانة</span><span class="px-3 py-1.5 rounded-full border border-border text-xs font-black">قطع غيار</span><span class="px-3 py-1.5 rounded-full border border-border text-xs font-black">زيوت</span><span class="px-3 py-1.5 rounded-full border border-border text-xs font-black">وقود</span><span class="px-3 py-1.5 rounded-full border border-border text-xs font-black">صيانة الشبكة</span><span class="px-3 py-1.5 rounded-full border border-border text-xs font-black">رواتب</span><span class="px-3 py-1.5 rounded-full border border-border text-xs font-black">أجور</span><span class="px-3 py-1.5 rounded-full border border-border text-xs font-black">أخرى</span></div>
      <div id="exp-list" class="space-y-2"><p class="text-sm font-bold text-muted-foreground">لا توجد مصروفات بعد — اضغط «مصروف جديد» للإضافة.</p></div>
    </section>

    <!-- ===== الدورات ===== -->
    <section id="cycles" class="rounded-3xl border border-border bg-card p-5 md:p-7">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
        <h2 class="text-2xl font-black">الدورات المحاسبية</h2>
        <button onclick="openCycleModal()" class="px-4 py-2.5 rounded-2xl border border-border bg-muted font-black">＋ دورة جديدة</button>
      </div>
      <p class="text-sm text-muted-foreground font-bold mb-3">لا يُسمح بأكثر من دورة مفتوحة. الدورة المغلقة تمنع الإضافة والتعديل.</p>
      <div id="cycle-list" class="grid md:grid-cols-2 gap-3"></div>
    </section>

    <!-- ===== التقارير ===== -->
    <section id="reports" class="rounded-3xl border border-border bg-card p-5 md:p-7">
      <h2 class="text-2xl font-black mb-3">التقارير</h2>
      <div class="flex flex-wrap gap-2 mb-4" id="report-tabs"></div>
      <div class="grid md:grid-cols-4 gap-2 mb-4">
        <select id="rep-cycle" onchange="renderReport()" class="px-3 py-2.5 rounded-2xl border border-border bg-background font-bold"></select>
        <select id="rep-type" onchange="renderReport()" class="px-3 py-2.5 rounded-2xl border border-border bg-background font-bold">
          <option value="">كل الأنواع</option><option>منزلي</option><option>تجاري</option><option>منزلي تجاري</option>
        </select>
        <input id="rep-search" oninput="renderReport()" placeholder="بحث…" class="md:col-span-2 px-4 py-2.5 rounded-2xl border border-border bg-background" />
      </div>
      <div class="flex flex-wrap gap-2 mb-3">
        <button onclick="printReport()" class="px-4 py-2 rounded-xl border border-border bg-muted font-black text-sm">🖨 طباعة التقرير</button>
        <button onclick="shareReport()" class="px-4 py-2 rounded-xl border border-border bg-muted font-black text-sm">📤 مشاركة</button>
        <button onclick="exportCSV()" class="px-4 py-2 rounded-xl text-white font-black text-sm" style="background:#0d9488">⬇ تصدير التقرير</button>
      </div>
      <div id="report-body" class="overflow-x-auto"></div>
    </section>

    <!-- ===== الإعدادات ===== -->
    <section id="settings" class="rounded-3xl border border-border bg-card p-5 md:p-7">
      <h2 class="text-2xl font-black mb-4">إعدادات المشروع والتعرفة</h2>
      <div class="grid md:grid-cols-2 gap-3">
        <label class="fld">اسم المشروع<input id="s-name" /></label>
        <label class="fld">المشغل / مدير المشروع<input id="s-operator" /></label>
        <label class="fld">الدولة<input id="s-country" /></label>
        <label class="fld">المحافظة<input id="s-gov" /></label>
        <label class="fld">المديرية<input id="s-dist" /></label>
        <label class="fld">شعار المشروع (نص)<input id="s-logo" /></label>
        <label class="fld md:col-span-2">النص أسفل الفاتورة<textarea id="s-footer" rows="2"></textarea></label>
      </div>
      <h3 class="font-black mt-6 mb-2">التعرفة (ريال لكل كيلو + المبلغ الثابت)</h3>
      <div class="grid md:grid-cols-3 gap-3" id="tariff-grid"></div>
      <div class="mt-4 flex flex-wrap gap-2">
        <button onclick="saveSettings()" class="px-5 py-3 rounded-2xl text-white font-black" style="background:linear-gradient(135deg,#0284c7,#0d9488)">حفظ الإعدادات</button>
        <button onclick="exportBackup()" class="px-5 py-3 rounded-2xl border border-border bg-muted font-black">حفظ نسخة في ملف على الهاتف</button>
        <label class="px-5 py-3 rounded-2xl border border-border bg-muted font-black cursor-pointer">استعادة نسخة<input type="file" id="restore-file" accept=".json" class="hidden" onchange="restoreBackup(this)" /></label>
      </div>
      <p class="mt-3 text-sm text-muted-foreground">تُحفظ بيانات المشروع والمدخلات على هذا الهاتف ولا تُرسل إلى سحابة. بعد النشر، افتح التطبيق مرة واحدة بالإنترنت وانتظر رسالة الجاهزية أدناه؛ بعدها يمكنك فتحه وإدارة المشتركين والفواتير والمصروفات والدورات والتقارير دون اتصال. من قائمة المتصفح أضفه إلى الشاشة الرئيسية. تسجيل الدخول والمشاركة الخارجية يحتاجان الإنترنت. احتفظ بنسخة مستقلة عبر «حفظ نسخة في ملف على الهاتف»؛ حذف بيانات المتصفح أو التطبيق يحذف السجلات المحلية، والنسخة المصدّرة لا تتحدث تلقائيًا.</p>
      <p id="offline-status" role="status" class="mt-3 text-sm font-bold">جارٍ التحقق من جاهزية العمل دون اتصال…</p>
      <button id="protect-local-data" class="btn mt-3" type="button">حماية حفظ البيانات على الهاتف</button>
      <p id="local-storage-status" role="status" class="mt-2 text-sm"></p>
      <p id="backup-info" class="mt-3 text-sm font-bold text-muted-foreground"></p>
    </section>

    <footer class="text-center text-sm text-muted-foreground font-bold pt-4">
      <p id="ftr-line">مشروع مياه قرية الجرشة العلياء • الجمهورية اليمنية</p>
      <p>© <span id="yr"></span> نظام إدارة مشروع المياه — جميع البيانات محفوظة على جهازك</p>
      <p class="mt-1 opacity-70">وحدة الاستهلاك: كيلو • العملة: ريال</p>
    </footer>
  </main>

  <!-- تنقل سفلي للجوال -->
  <nav class="fixed bottom-0 inset-x-0 z-50 border-t border-border bg-card/95 backdrop-blur md:hidden">
    <div class="grid grid-cols-7 text-[10px] font-black text-center">
      <a href="#dashboard" class="py-2.5">🏠<br/>الرئيسية</a>
      <a href="#subscribers" class="py-2.5">👥<br/>المشتركون</a>
      <a href="#invoices" class="py-2.5">🧾<br/>الفواتير</a>
      <a href="#expenses" class="py-2.5">💸<br/>المصروفات</a>
      <a href="#cycles" class="py-2.5">🔄<br/>الدورات</a>
      <a href="#reports" class="py-2.5">📊<br/>التقارير</a>
      <a href="#settings" class="py-2.5">⚙️<br/>الإعدادات</a>
    </div>
  </nav>

  <!-- نافذة منبثقة عامة -->
  <div id="modal" class="fixed inset-0 z-[60] hidden items-center justify-center p-4 bg-black/60">
    <div class="w-full max-w-lg rounded-3xl bg-card border border-border p-5 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between mb-3">
        <h3 id="modal-title" class="font-black text-xl"></h3>
        <button onclick="closeModal()" class="w-9 h-9 rounded-xl bg-muted font-black">✕</button>
      </div>
      <div id="modal-body"></div>
    </div>
  </div>

  <!-- منطقة طباعة الفاتورة -->
  <div id="print-area" class="hidden"></div>
</div>

<style>
  .navlink{padding:.5rem .9rem;border-radius:.9rem;border:1px solid var(--border);background:var(--muted);white-space:nowrap}
  .fld{display:flex;flex-direction:column;gap:.35rem;font-weight:800;font-size:.85rem}
  .fld input,.fld textarea,.fld select{padding:.65rem .9rem;border-radius:1rem;border:1px solid var(--border);background:var(--background);font-weight:600}
  :global(.card){background:var(--background);border:1px solid var(--border);border-radius:1.25rem;padding:1rem}
  :global(.btn){padding:.55rem .9rem;border-radius:.9rem;border:1px solid var(--border);background:var(--muted);font-weight:800;font-size:.85rem}
  :global(.btn-p){padding:.55rem .9rem;border-radius:.9rem;font-weight:800;font-size:.85rem;color:#fff;background:linear-gradient(135deg,#0284c7,#0d9488)}
  :global(.btn-d){background:#e11d48;color:#fff;padding:.55rem .9rem;border-radius:.9rem;font-weight:800;font-size:.85rem}
  :global(.badge){display:inline-block;padding:.2rem .7rem;border-radius:999px;font-size:.75rem;font-weight:800;border:1px solid var(--border)}
  :global(table.rep){width:100%;border-collapse:collapse;font-size:.85rem;min-width:640px}
  :global(table.rep) th,:global(table.rep) td{border:1px solid var(--border);padding:.5rem .6rem;text-align:right}
  :global(table.rep) th{background:var(--muted);font-weight:900}
  @media print{ header,nav,main section:not(.print-keep),footer,#modal{display:none!important} #print-area{display:block!important} }
  #print-area{display:none}
  section[id]{scroll-margin-top:130px}
  html{scroll-behavior:smooth}
  @media(max-width:767px){
    #app-root main{padding:1rem .75rem calc(6rem + env(safe-area-inset-bottom));}
    #app-root main>section{padding:1rem;border-radius:1.25rem;min-width:0;}
    #app-root main>section:first-of-type h1{font-size:1.65rem;}
    #app-root .quick-actions>a{padding:.75rem .3rem;font-size:.85rem;}
    #dashboard>div:first-child{flex-wrap:wrap;gap:.75rem;}
    #dash-cycle{width:100%;}
    #app-root :global(input:not([type=checkbox]):not([type=file])),#app-root :global(select),#app-root :global(textarea){min-width:0;max-width:100%;font-size:16px;min-height:44px;}
    #app-root :global(.grid)>*,#app-root :global(.flex)>*{min-width:0;}
    #app-root :global(.card){overflow-wrap:anywhere;padding:.8rem;}
    #app-root :global(button),#app-root :global(.btn),#app-root :global(.btn-p),#app-root :global(.btn-d){min-height:44px;touch-action:manipulation;}
    #dash-cards :global(.text-lg){font-size:1rem;overflow-wrap:anywhere;}
    #dash-latest :global(.card),#exp-list :global(.card){flex-wrap:wrap;gap:.65rem;}
    #exp-list :global(.card)>div:last-child{width:100%;justify-content:space-between;flex-wrap:wrap;}
    #report-body{max-width:100%;overscroll-behavior-x:contain;}
    #modal{padding:.5rem;}
    #modal>div{max-height:calc(100dvh - 1rem);padding:1rem;overscroll-behavior-y:contain;}
    #modal-body :global(.grid-cols-2){grid-template-columns:minmax(0,1fr);}
    #modal-body :global(.flex){flex-wrap:wrap;}
    #modal-title{font-size:1.05rem;overflow-wrap:anywhere;}
    #app-root>nav:last-of-type{padding-bottom:env(safe-area-inset-bottom);}
    #app-root>nav:last-of-type>div{display:flex;overflow-x:auto;overscroll-behavior-x:contain;}
    #app-root>nav:last-of-type a{flex:1 0 64px;min-height:52px;font-size:11px;}
    section[id]{scroll-margin-top:200px;}
  }
  :global(.inv-paper){background:#fff;color:#111;border-radius:1rem;padding:1.25rem}
</style>

<script>
const LS='wms_db_v1';
const $=id=>document.getElementById(id);
const fmt=n=>Number(n||0).toLocaleString('ar-YE');
function scrollToId(id){document.getElementById(id)?.scrollIntoView({behavior:'smooth'})}
$('yr').textContent=new Date().getFullYear();

let DB=null;
function seed(){return{
 settings:{name:'مشروع مياه قرية الجرشة العلياء',country:'الجمهورية اليمنية',gov:'محافظة صنعاء',dist:'مديرية همدان',operator:'إدارة المشروع',logo:'💧',footer:'إن تسديدكم لفواتير المياه يؤكد حرصكم على استمرار الخدمة',
  tariffs:{'منزلي':{price:200,fixed:2000},'تجاري':{price:400,fixed:5000},'منزلي تجاري':{price:300,fixed:3000}}},
 cycles:[{id:'c1',name:'دورة يناير 2026',from:'2026-01-01',to:'2026-01-31',status:'مفتوحة'}],
 subscribers:[
  {meterNo:'1001',name:'أحمد محمد الحميري',phone:'771234567',type:'منزلي',address:'حارة السوق',notes:'',active:true},
  {meterNo:'1002',name:'متجر النور التجاري',phone:'772345678',type:'تجاري',address:'الشارع العام',notes:'',active:true},
