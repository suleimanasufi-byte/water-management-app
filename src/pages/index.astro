function saveSub(old){
  const m=$('f-meter').value.trim(),n=$('f-name').value.trim();
  if(!m)return toast('يرجى إدخال رقم العداد.');if(!n)return toast('يرجى إدخال اسم المشترك.');
  if(!old&&DB.subscribers.some(s=>s.meterNo===m))return toast('رقم العداد مستخدم بالفعل.');
  const obj={meterNo:m,name:n,phone:$('f-phone').value.trim(),type:$('f-type').value,address:$('f-addr').value.trim(),notes:$('f-notes').value.trim(),active:$('f-active').checked};
