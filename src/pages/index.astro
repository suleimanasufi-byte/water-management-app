   <div class="grid grid-cols-2 gap-2"><label class="fld">المتأخرات<input type="number" id="v-arr" value="${inv?.arrears??last?.remainingOn??0}" oninput="invLive()" /></label>
   <label class="fld">الرصيد السابق (له)<input type="number" id="v-bal" value="${inv?.prevBalance??last?.remainingFor??0}" oninput="invLive()" /></label></div>
   <div class="grid grid-cols-2 gap-2"><label class="fld">الغرامات<input type="number" id="v-fine" value="${inv?.fine||0}" oninput="invLive()" /></label>
   <label class="fld">النقد المدفوع حاليًا<input type="number" id="v-cash" value="${inv?.cashPaid||0}" oninput="invLive()" /></label></div>
   <div id="v-live" class="rounded-2xl border border-border bg-background p-3 text-sm font-bold"></div>
   <button class="btn-p !py-3" onclick="saveInv('${id}')">حفظ الفاتورة</button></div>`);
  invLive();
}
function invAuto(){const l=lastInvoice($('v-sub').value);$('v-prev').value=l?.curr??0;$('v-arr').value=l?.remainingOn??0;$('v-bal').value=l?.remainingFor??0;invLive()}
function invLive(){
  const m=$('v-sub').value,s=DB.subscribers.find(x=>x.meterNo===m);
  const c=calcInvoice({meterNo:m,type:s?.type||'منزلي',prev:+$('v-prev').value||0,curr:+$('v-curr').value||0,fine:+$('v-fine').value||0,cashPaid:+$('v-cash').value||0,arrears:+$('v-arr').value||0,prevBalance:+$('v-bal').value||0});
  $('v-live').innerHTML=`الاستهلاك: <b>${fmt(c.cons)} كيلو</b> ${statusBadge(c.status)}<br/>قيمة الاستهلاك: ${fmt(c.consValue)} ريال • الإجمالي المستحق: <b>${fmt(c.totalDue)} ريال</b><br/>إجمالي المستلم: ${fmt(c.totalReceived)} ريال (نقد ${fmt(c.cashPaid)} + رصيد ${fmt(c.prevBalance)})<br/>${c.remainingOn?`<span style="color:var(--destructive)">الباقي عليه: ${fmt(c.remainingOn)} ريال</span>`:c.remainingFor?`<span style="color:var(--accent)">الباقي له: ${fmt(c.remainingFor)} ريال</span>`:'لا باقي — مسدد بالكامل'}`;
}
function saveInv(id){
  if(!$('v-curr').value)return toast('يرجى إدخال القراءة الحالية.');
  const oc=openCycle();if(!oc)return toast('لا يمكن إضافة الفاتورة لأن الدورة المحاسبية مغلقة.');
  if(id&&cycleOf(DB.invoices.find(i=>i.id===id)?.cycleId)?.status!=='مفتوحة')return toast('لا يمكن تعديل فاتورة في دورة مغلقة.');
  const m=$('v-sub').value;if(!m)return toast('أضف مشتركًا نشطًا أولًا.');if(!$('v-date').value)return toast('حدد تاريخ الفاتورة.');if(['v-prev','v-curr','v-fine','v-cash','v-arr','v-bal'].some(k=>+$(k).value<0))return toast('لا يُسمح بقيم سالبة.');
  if(id){const inv=DB.invoices.find(i=>i.id===id);Object.assign(inv,{meterNo:m,prev:+$('v-prev').value||0,curr:+$('v-curr').value||0,date:$('v-date').value,fine:+$('v-fine').value||0,cashPaid:+$('v-cash').value||0,arrears:+$('v-arr').value||0,prevBalance:+$('v-bal').value||0});}
  else{const n='F-'+String(Math.max(0,...DB.invoices.map(i=>Number(i.id.replace('F-',''))||0))+1).padStart(4,'0');DB.invoices.push({id:n,meterNo:m,prev:+$('v-prev').value||0,curr:+$('v-curr').value||0,date:$('v-date').value,cycleId:oc.id,fine:+$('v-fine').value||0,cashPaid:+$('v-cash').value||0,arrears:+$('v-arr').value||0,prevBalance:+$('v-bal').value||0});}
  save();closeModal();renderAll();toast('تم حفظ الفاتورة بنجاح.');
}
function delInv(id){const inv=DB.invoices.find(i=>i.id===id);if(cycleOf(inv.cycleId)?.status!=='مفتوحة')return toast('لا يمكن حذف فاتورة في دورة مغلقة.');if(!confirm('تأكيد حذف الفاتورة '+id+'؟'))return;DB.invoices=DB.invoices.filter(i=>i.id!==id);save();renderAll()}

function openExpModal(){
  const oc=openCycle();if(!oc)return toast('لا يمكن إضافة المصروف لأن الدورة مغلقة أو لا توجد دورة مفتوحة.');
  openModal('مصروف جديد',`<div class="grid gap-2.5"><div class="grid grid-cols-2 gap-2"><label class="fld">التصنيف<select id="e-cat">${CATS.map(c=>`<option>${c}</option>`).join('')}</select></label>
  <label class="fld">المبلغ (ريال) *<input type="number" id="e-amt" /></label></div>
  <label class="fld">الوصف<input id="e-desc" /></label>
  <div class="grid grid-cols-2 gap-2"><label class="fld">التاريخ<input type="date" id="e-date" value="${new Date().toISOString().slice(0,10)}" /></label>
  <label class="fld">المدفوع له<input id="e-to" /></label></div>
  <label class="fld">ملاحظات<input id="e-notes" /></label>
  <button class="btn-p !py-3" onclick="saveExp()">حفظ المصروف</button></div>`);
}
function saveExp(){if(!openCycle())return toast('لا توجد دورة مفتوحة.');if(!$('e-date').value)return toast('حدد تاريخ المصروف.');const a=+$('e-amt').value||0;if(a<=0)return toast('يرجى إدخال مبلغ المصروف.');const oc=openCycle();DB.expenses.push({id:'E-'+Date.now(),category:$('e-cat').value,desc:$('e-desc').value||$('e-cat').value,amount:a,date:$('e-date').value,paidTo:$('e-to').value,notes:$('e-notes').value,cycleId:oc.id});save();closeModal();renderAll();toast('تم حفظ المصروف.')}
function delExp(id){const e=DB.expenses.find(x=>x.id===id);if(!e||cycleOf(e.cycleId)?.status!=='مفتوحة')return toast('لا يمكن حذف مصروف في دورة مغلقة.');if(!confirm('حذف المصروف؟'))return;DB.expenses=DB.expenses.filter(e=>e.id!==id);save();renderAll()}

function openCycleModal(){openModal('دورة جديدة',`<div class="grid gap-2.5"><label class="fld">اسم الدورة<input id="c-name" placeholder="دورة فبراير 2026" /></label><div class="grid grid-cols-2 gap-2"><label class="fld">من<input type="date" id="c-from" /></label><label class="fld">إلى<input type="date" id="c-to" /></label></div><button class="btn-p !py-3" onclick="saveCycle()">إنشاء وفتح الدورة</button></div>`)}
function saveCycle(){if(openCycle())return toast('لا يمكن: توجد دورة مفتوحة بالفعل. أغلقها أولًا.');const n=$('c-name').value.trim(),from=$('c-from').value,to=$('c-to').value;if(!n||!from||!to)return toast('أدخل اسم الدورة وتاريخ البداية والنهاية.');if(to<from)return toast('تاريخ النهاية يجب ألا يسبق البداية.');if(DB.cycles.some(c=>c.from&&c.to&&from<=c.to&&to>=c.from))return toast('تواريخ الدورة تتداخل مع دورة سابقة.');const cycle={id:'c'+Date.now(),name:n,from,to,status:'مفتوحة'};DB.cycles.push(cycle);save();closeModal();fillCycleSelects();['dash-cycle','inv-filter-cycle','rep-cycle'].forEach(id=>$(id).value=cycle.id);renderAll();toast('تم إنشاء وفتح الدورة الجديدة بنجاح.')}
function closeCycle(id){const c=cycleOf(id);if(!c||c.status!=='مفتوحة')return;openModal('إغلاق الدورة وفتح دورة جديدة',`<p class="font-bold mb-4">سيتم إغلاق الدورة الحالية مع الاحتفاظ بفواتيرها ومصروفاتها، ثم إدخال بيانات الدورة الجديدة.</p><button id="confirm-close-cycle" class="btn-p">تأكيد الإغلاق والمتابعة</button>`);$('confirm-close-cycle').onclick=()=>{c.status='مغلقة';save();renderAll();openCycleModal();toast('تم إغلاق الدورة. أدخل بيانات الدورة الجديدة.')}}
function reopenCycle(id){if(openCycle())return toast('توجد دورة مفتوحة أخرى.');DB.cycles.find(c=>c.id===id).status='مفتوحة';save();renderAll()}
function delCycle(id){if(DB.invoices.some(i=>i.cycleId===id)||DB.expenses.some(e=>e.cycleId===id))return toast('لا يمكن حذف دورة مرتبطة بفواتير أو مصروفات.');if(!confirm('تأكيد حذف الدورة؟'))return;DB.cycles=DB.cycles.filter(c=>c.id!==id);save();renderAll()}

/* كشف حساب + فاتورة */
function statement(m){
  const s=DB.subscribers.find(x=>x.meterNo===m);const invs=DB.invoices.filter(i=>i.meterNo===m).map(enrich).sort((a,b)=>a.date.localeCompare(b.date));
  const t={c:0,b:0,cash:0,d:0,bl:0};invs.forEach(i=>{t.c+=i.cons;t.b+=i.consValue+i.fine;t.cash+=i.cashPaid});const latest=lastInvoice(m);t.d=latest?.remainingOn||0;t.bl=latest?.remainingFor||0;
  openModal('كشف حساب: '+s.name,`<div class="text-sm font-bold space-y-1"><p>العداد ${s.meterNo} • ${s.type} • ${s.phone||''} • ${s.address||''}</p>
  <div class="grid grid-cols-2 gap-2"><div class="card">إجمالي الاستهلاك<br/><b>${fmt(t.c)} كيلو</b></div><div class="card">إجمالي الفواتير<br/><b>${fmt(t.b)} ريال</b></div><div class="card">المدفوع نقدًا<br/><b>${fmt(t.cash)} ريال</b></div><div class="card">الديون / الأرصدة<br/><b>${fmt(t.d)} / ${fmt(t.bl)} ريال</b></div></div>
  <div class="overflow-x-auto"><table class="rep"><thead><tr><th>التاريخ</th><th>سابق</th><th>حالي</th><th>كيلو</th><th>الحالة</th><th>الإجمالي</th><th>المدفوع</th><th>عليه/له</th></tr></thead><tbody>
  ${invs.map(i=>`<tr><td>${i.date}</td><td>${fmt(i.prev)}</td><td>${fmt(i.curr)}</td><td>${fmt(i.cons)}</td><td>${i.status}</td><td>${fmt(i.totalDue)}</td><td>${fmt(i.cashPaid)}</td><td>${i.remainingOn?'عليه '+fmt(i.remainingOn):i.remainingFor?'له '+fmt(i.remainingFor):'—'}</td></tr>`).join('')||'<tr><td colspan=8>لا فواتير</td></tr>'}
  </tbody></table></div><div class="flex gap-2"><button class="btn" onclick="printStatement()">طباعة الكشف</button><button class="btn" onclick="newInvoiceFor('${m}')">فاتورة جديدة</button></div></div>`);
}
function invHTML(i){
  const s=DB.settings;
  return`<div class="inv-paper"><div class="text-center border-b-2 border-slate-800 pb-3"><div class="text-4xl">${s.logo||'💧'}</div><p class="font-black">${s.country} • ${s.gov} • ${s.dist}</p><h3 class="font-black text-xl">${s.name}</h3><p class="text-sm font-bold">المشغل: ${s.operator} • الدورة: ${cycleOf(i.cycleId)?.name||''}</p></div>
  <div class="grid grid-cols-2 gap-2 mt-3 text-sm font-bold"><p>رقم الفاتورة: ${i.id}</p><p>التاريخ: ${i.date}</p><p>المشترك: ${i.subName}</p><p>العداد: ${i.meterNo} • ${i.subType}</p><p>الهاتف: ${i.phone||'—'}</p><p>الحالة: ${i.status}</p></div>
  <table class="w-full mt-3 text-sm" style="border-collapse:collapse"><tbody>
  ${[['القراءة السابقة',fmt(i.prev)],['القراءة الحالية',fmt(i.curr)],['الاستهلاك (كيلو)',fmt(i.cons)+' كيلو'],['قيمة الاستهلاك',fmt(i.consValue)+' ريال'],['المتأخرات',fmt(i.arrears)+' ريال'],['الغرامات',fmt(i.fine)+' ريال'],['إجمالي المستحق',fmt(i.totalDue)+' ريال'],['الرصيد السابق (له)',fmt(i.prevBalance)+' ريال'],['النقد المدفوع',fmt(i.cashPaid)+' ريال'],['إجمالي المستلم',fmt(i.totalReceived)+' ريال'],['الباقي عليه',fmt(i.remainingOn)+' ريال'],['الباقي له',fmt(i.remainingFor)+' ريال']].map(r=>`<tr><td style="border:1px solid #999;padding:.4rem" >${r[0]}</td><td style="border:1px solid #999;padding:.4rem;font-weight:800">${r[1]}</td></tr>`).join('')}
  </tbody></table><p class="text-center text-xs font-bold mt-3">${s.footer}</p></div>`;
}
function viewInvoice(id){const i=DB.invoices.map(enrich).find(x=>x.id===id);openModal('فاتورة '+id,invHTML(i)+`<div class="flex flex-wrap gap-2 mt-3"><button class="btn" onclick="printInvoice('${id}')">🖨 طباعة / PDF</button><button class="btn" onclick="shareInvoice('${id}')">📤 مشاركة / واتساب</button></div>`)}
function printInvoice(id){const i=DB.invoices.map(enrich).find(x=>x.id===id);$('print-area').innerHTML=invHTML(i);window.print()}
function shareInvoice(id){
  const i=DB.invoices.map(enrich).find(x=>x.id===id);
  const txt=`${DB.settings.name}%0Aفاتورة ${i.id} • ${i.subName}%0Aالاستهلاك ${i.cons} كيلو • الإجمالي ${fmt(i.totalDue)} ريال%0Aالمدفوع ${fmt(i.cashPaid)} ريال • الباقي عليه ${fmt(i.remainingOn)} • له ${fmt(i.remainingFor)}`;
  if(navigator.share){navigator.share({title:'فاتورة '+i.id,text:`فاتورة ${i.id} — ${i.subName}: ${i.cons} كيلو، الإجمالي ${i.totalDue} ريال`}).catch(()=>{})}
  else window.open('https://wa.me/?text='+encodeURIComponent(txt.replace(/%0A/g,'\n')),'_blank','noopener');
}
function shareReport(){const t=`تقرير ${repTab} — ${DB.settings.name}`,text=t+'\n'+$('report-body').innerText;if(navigator.share)navigator.share({title:t,text}).catch(()=>{});else window.open('https://wa.me/?text='+encodeURIComponent(text),'_blank','noopener')}
function exportCSV(){const tbl=document.querySelector('#report-body table');if(!tbl){toast('لا بيانات للتصدير.');return}let rows=[...tbl.querySelectorAll('tr')].map(tr=>[...tr.querySelectorAll('th,td')].map(c=>'"'+(c.innerText||'').replace(/"/g,'""')+'"').join(','));const blob=new Blob(["\ufeff"+rows.join('\n')],{type:'text/csv;charset=utf-8'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='تقرير-'+Date.now()+'.csv';a.click();toast('تم تصدير التقرير.')}
function exportSubs(){if(!DB.subscribers.length){toast('لا مشتركين للتصدير.');return}let rows=['"رقم العداد","الاسم","الهاتف","النوع","العنوان"'].concat(DB.subscribers.map(s=>`"${s.meterNo}","${s.name}","${s.phone||''}","${s.type}","${s.address||''}"`));const blob=new Blob(["\ufeff"+rows.join('\n')],{type:'text/csv;charset=utf-8'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='المشتركون-'+Date.now()+'.csv';a.click();toast('تم تصدير المشتركين.')}
function exportInvs(){const list=DB.invoices.map(enrich);if(!list.length){toast('لا فواتير للتصدير.');return}let rows=['"رقم الفاتورة","المشترك","الاستهلاك كيلو","الإجمالي","المدفوع","الباقي عليه","الباقي له"'].concat(list.map(i=>`"${i.id}","${i.subName}",${i.cons},${i.totalDue},${i.cashPaid},${i.remainingOn},${i.remainingFor}`));const blob=new Blob(["\ufeff"+rows.join('\n')],{type:'text/csv;charset=utf-8'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='الفواتير-'+Date.now()+'.csv';a.click();toast('تم تصدير الفواتير.')}

/* الإعدادات */
function renderSettingsForm(){
  const s=DB.settings;$('s-name').value=s.name;$('s-operator').value=s.operator;$('s-country').value=s.country;$('s-gov').value=s.gov;$('s-dist').value=s.dist;$('s-logo').value=s.logo||'';$('s-footer').value=s.footer||'';
  $('tariff-grid').innerHTML=Object.entries(s.tariffs).map(([k,v])=>`<div class="card"><p class="font-black mb-2">${k}</p><label class="fld">سعر الكيلو (ريال)<input type="number" id="t-${k}-p" value="${v.price}" /></label><label class="fld mt-2">المبلغ الثابت (ريال)<input type="number" id="t-${k}-f" value="${v.fixed}" /></label></div>`).join('');
}
function saveSettings(){
  if(Object.keys(DB.settings.tariffs).some(k=>['p','f'].some(s=>!Number.isFinite(Number($('t-'+k+'-'+s).value))||Number($('t-'+k+'-'+s).value)<0)))return toast('أدخل تعرفة صحيحة غير سالبة.');
  const s=DB.settings;s.name=$('s-name').value.trim()||s.name;s.operator=$('s-operator').value;s.country=$('s-country').value;s.gov=$('s-gov').value;s.dist=$('s-dist').value;s.logo=$('s-logo').value;s.footer=$('s-footer').value;
  Object.keys(s.tariffs).forEach(k=>{s.tariffs[k]={price:+$('t-'+k+'-p').value||0,fixed:+$('t-'+k+'-f').value||0}});
  save();renderAll();toast('تم حفظ الإعدادات.');
}

/* النسخ الاحتياطي */
function exportBackup(){
  DB.lastBackup=new Date().toLocaleString('ar-YE');save();
  const blob=new Blob([JSON.stringify(DB)],{type:'application/json'});
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='backup-water-'+Date.now()+'.json';a.click();
  renderAll();toast('تم إنشاء النسخة الاحتياطية.');
}
function restoreBackup(input){
  const f=input.files[0];if(!f)return;
  if(!confirm('استعادة النسخة؟ سيتم استبدال البيانات الحالية بعد التحقق من صحة الملف.')){input.value='';return}
  const r=new FileReader();
  r.onload=()=>{try{const d=JSON.parse(r.result);if(!d.settings?.tariffs||!Array.isArray(d.subscribers)||!Array.isArray(d.invoices)||!Array.isArray(d.cycles)||!Array.isArray(d.expenses)||d.cycles.filter(c=>c.status==='مفتوحة').length>1)throw 0;DB=d;save();renderAll();toast('تمت الاستعادة بنجاح.')}catch{toast('تعذر استعادة النسخة الاحتياطية.')}};
  r.readAsText(f);input.value='';
}

/* الثيم + تنبيه */
function toast(m){const t=document.createElement('div');t.textContent=m;t.style.cssText='position:fixed;bottom:80px;right:50%;transform:translateX(50%);background:#0f172a;color:#fff;padding:.7rem 1.2rem;border-radius:1rem;font-weight:800;z-index:99';document.body.appendChild(t);setTimeout(()=>t.remove(),2600)}
if($('theme-btn'))$('theme-btn').onclick=()=>{const h=document.documentElement;const dark=h.dataset.theme!=='dark';h.dataset.theme=dark?'dark':'light';h.classList.toggle('dark',dark);$('theme-btn').textContent=dark?'☀️ فاتح':'🌙 داكن'};
document.documentElement.dataset.theme=document.documentElement.classList.contains('dark')?'dark':'light';
const darkCSS=document.createElement('style');darkCSS.textContent=`html[data-theme="dark"]{--background:#0d0c14;--foreground:#eceaf4;--card:#151421;--muted:#201d31;--border:#2a2741}html[data-theme="light"]{--background:#f4f7fa;--foreground:#0f172a;--card:#ffffff;--muted:#e8eff5;--border:#d5e0ea}.text-muted-foreground{color:#64748b}html[data-theme="dark"] .text-muted-foreground{color:#9d98b0}`;document.head.appendChild(darkCSS);
window.addEventListener('offline',()=>toast('أنت دون اتصال؛ تستمر إدارة البيانات المحفوظة على الهاتف.'));
if(window.waterOfflineStatus)$('offline-status').textContent=window.waterOfflineStatus;
$('protect-local-data').onclick=async()=>{
  const out=$('local-storage-status');
  if(!navigator.storage?.persist){out.textContent='المتصفح لا يتيح حماية التخزين؛ احفظ نسخة احتياطية مستقلة.';return;}
  try{const granted=await navigator.storage.persist();out.textContent=granted?'تم منح حماية التخزين من الإزالة التلقائية. لا تحذف بيانات المتصفح، واحتفظ بنسخة احتياطية.':'لم يمنح المتصفح الحماية؛ تبقى البيانات محليًا، لكن احفظ نسخة احتياطية بانتظام.';}catch{out.textContent='تعذر تفعيل الحماية. احفظ نسخة احتياطية مستقلة.';}
};
Object.assign(window,{scrollToId,renderAll,renderSubs,renderInvs,renderReport,openSubModal,saveSub,delSub,newInvoiceFor,openInvModal,invAuto,invLive,saveInv,delInv,openExpModal,saveExp,delExp,openCycleModal,saveCycle,closeCycle,reopenCycle,delCycle,closeModal,statement,viewInvoice,printInvoice,shareInvoice,shareReport,exportCSV,exportSubs,exportInvs,saveSettings,exportBackup,restoreBackup,renderReportTabs,printReport,printStatement,selectReport});
function selectReport(tab){repTab=tab;renderReportTabs();renderReport()}
function printReport(){$('print-area').innerHTML='<h2>'+DB.settings.name+' — '+repTab+'</h2>'+$('report-body').innerHTML;window.print()}
function printStatement(){$('print-area').innerHTML='<h2>'+$('modal-title').textContent+'</h2>'+$('modal-body').innerHTML;window.print()}
load();renderAll();
</script>
</Base>
