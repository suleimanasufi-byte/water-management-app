/* لوحة التحكم */
function filteredInv(){const c=$('dash-cycle').value;return DB.invoices.filter(i=>!c||i.cycleId===c).map(enrich)}
function renderDash(){
  const invs=filteredInv();
  const cId=$('dash-cycle').value;
  const exps=DB.expenses.filter(e=>!cId||e.cycleId===cId);
  const tCons=invs.reduce((a,i)=>a+i.cons,0),tBills=invs.reduce((a,i)=>a+i.totalDue,0);
  const tCash=invs.reduce((a,i)=>a+i.cashPaid,0); // نقد فعلي فقط
  const tDebt=invs.reduce((a,i)=>a+i.remainingOn,0),tBal=invs.reduce((a,i)=>a+i.remainingFor,0);
  const tExp=exps.reduce((a,e)=>a+(+e.amount||0),0),net=tCash-tExp;
  const cards=[['إجمالي الاستهلاك',fmt(tCons)+' كيلو','💧'],['إجمالي الفواتير',fmt(tBills)+' ريال','🧾'],['المقبوض النقدي الفعلي',fmt(tCash)+' ريال','💵'],['المتبقي على المشتركين',fmt(tDebt)+' ريال','⚠️'],['أرصدة المشتركين',fmt(tBal)+' ريال','💰'],['إجمالي المصروفات',fmt(tExp)+' ريال','💸'],['صافي النقد المتوفر',fmt(net)+' ريال','🏦'],['عدد الفواتير',invs.length,'📊']];
  $('dash-cards').innerHTML=cards.map(c=>`<div class="card"><div class="text-2xl">${c[2]}</div><div class="text-xs font-bold text-muted-foreground mt-1">${c[0]}</div><div class="font-black text-lg">${c[1]}</div></div>`).join('');
  const mx=Math.max(tCash,tExp,1);
  $('bar-chart').innerHTML=[['التحصيل النقدي',tCash,'#0d9488'],['المصروفات',tExp,'#e11d48'],['الصافي',Math.max(net,0),'#0284c7']].map(r=>`<div><div class="flex justify-between text-xs font-black"><span>${r[0]}</span><span>${fmt(r[1])} ريال</span></div><div class="h-2.5 rounded-full bg-muted"><div class="h-2.5 rounded-full" style="width:${Math.round(r[1]/mx*100)}%;background:${r[2]}"></div></div></div>`).join('');
  const groups={};invs.forEach(i=>groups[i.status]=(groups[i.status]||0)+1);
  $('meter-chart').innerHTML=Object.entries(groups).map(([k,v])=>`${statusBadge(k)} <b>${v}</b>`).join(' ')||'<span class="text-sm text-muted-foreground font-bold">لا فواتير بعد</span>';
  $('dash-latest').innerHTML=invs.slice(-4).reverse().map(i=>`<div class="card !p-2.5 flex justify-between"><span><b>${i.id}</b> • ${i.subName}<br/><span class="text-muted-foreground">${i.cons} كيلو • ${fmt(i.totalDue)} ريال</span></span>${statusBadge(i.status)}</div>`).join('')||'لا فواتير';
}

